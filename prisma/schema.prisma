generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Batch {
  Id        Int          @id @default(autoincrement()) @db.UnsignedInt
  CompanyId Int          @db.UnsignedInt
  Name      String       @db.VarChar(150)
  StartsAt  DateTime
  EndsAt    DateTime
  Status    Batch_Status @default(SCHEDULED)
  CreatedAt DateTime     @default(now())
  UpdatedAt DateTime     @default(now())
  DeletedAt DateTime?
  Company   Company      @relation(fields: [CompanyId], references: [Id], map: "FK_Batch_CompanyId")
  BatchSend BatchSend[]

  @@index([CompanyId], map: "FK_Batch_CompanyId")
}

model BatchSend {
  Id               Int              @id @default(autoincrement()) @db.UnsignedInt
  CompanyId        Int              @db.UnsignedInt
  BatchId          Int              @db.UnsignedInt
  ContactId        Int              @db.UnsignedInt
  TemplateId       Int              @db.UnsignedInt
  TemplateSnapshot Json
  Status           BatchSend_Status @default(WAITING)
  Attempts         Int              @default(0) @db.UnsignedInt
  ErrorCode        String?          @db.VarChar(100)
  ErrorMessage     String?          @db.VarChar(1000)
  ScheduledAt      DateTime?
  StartedAt        DateTime?
  FinishedAt       DateTime?
  MessageId        String?          @db.VarChar(255)
  CreatedAt        DateTime         @default(now())
  UpdatedAt        DateTime         @default(now())
  Batch            Batch            @relation(fields: [BatchId], references: [Id], map: "FK_BatchSend_BatchId")
  Company          Company          @relation(fields: [CompanyId], references: [Id], map: "FK_BatchSend_CompanyId")
  Contact          Contact          @relation(fields: [ContactId], references: [Id], map: "FK_BatchSend_ContactId")
  Template         Template         @relation(fields: [TemplateId], references: [Id], map: "FK_BatchSend_TemplateId")

  @@unique([BatchId, ContactId, TemplateId], map: "UK_BatchSend_Batch_Contact_Template")
  @@index([CompanyId], map: "FK_BatchSend_CompanyId")
  @@index([ContactId], map: "FK_BatchSend_ContactId")
  @@index([TemplateId], map: "FK_BatchSend_TemplateId")
}

model Company {
  Id          Int         @id @default(autoincrement()) @db.UnsignedInt
  Name        String      @db.VarChar(150)
  Document    String      @unique(map: "UK_Company_Document") @db.VarChar(14)
  Description String?     @db.Text
  CreatedAt   DateTime    @default(now())
  UpdatedAt   DateTime    @default(now())
  DeletedAt   DateTime?
  Batch       Batch[]
  BatchSend   BatchSend[]
  Contact     Contact[]
  List        List[]
  Template    Template[]
  User        User[]
}

model Contact {
  Id        Int         @id @default(autoincrement()) @db.UnsignedInt
  CompanyId Int         @db.UnsignedInt
  ListId    Int         @db.UnsignedInt
  Name      String      @db.VarChar(150)
  Phone     String      @unique(map: "UK_Contact_Phone") @db.VarChar(20)
  CreatedAt DateTime    @default(now())
  UpdatedAt DateTime    @default(now())
  DeletedAt DateTime?
  BatchSend BatchSend[]
  Company   Company     @relation(fields: [CompanyId], references: [Id], map: "FK_Contact_CompanyId")
  List      List        @relation(fields: [ListId], references: [Id], map: "FK_Contact_ListId")
  Note      Note[]

  @@index([CompanyId], map: "FK_Contact_CompanyId")
  @@index([ListId], map: "FK_Contact_ListId")
}

model List {
  Id        Int       @id @default(autoincrement()) @db.UnsignedInt
  CompanyId Int       @db.UnsignedInt
  Name      String    @db.VarChar(150)
  Subject   String    @db.VarChar(255)
  Color     String    @db.VarChar(7)
  CreatedAt DateTime  @default(now())
  UpdatedAt DateTime  @default(now())
  DeletedAt DateTime?
  Contact   Contact[]
  Company   Company   @relation(fields: [CompanyId], references: [Id], map: "FK_List_CompanyId")

  @@index([CompanyId], map: "FK_List_CompanyId")
}

model Note {
  Id        Int       @id @default(autoincrement()) @db.UnsignedInt
  ContactId Int       @db.UnsignedInt
  Content   String    @db.Text
  CreatedAt DateTime  @default(now())
  UpdatedAt DateTime  @default(now())
  DeletedAt DateTime?
  Contact   Contact   @relation(fields: [ContactId], references: [Id], map: "FK_Note_ContactId")

  @@index([ContactId], map: "FK_Note_ContactId")
}

model Template {
  Id        Int         @id @default(autoincrement()) @db.UnsignedInt
  CompanyId Int         @db.UnsignedInt
  Name      String      @db.VarChar(150)
  Content   Json
  CreatedAt DateTime    @default(now())
  UpdatedAt DateTime    @default(now())
  DeletedAt DateTime?
  BatchSend BatchSend[]
  Company   Company     @relation(fields: [CompanyId], references: [Id], map: "FK_Template_CompanyId")

  @@index([CompanyId], map: "FK_Template_CompanyId")
}

model User {
  Id                 Int       @id @default(autoincrement()) @db.UnsignedInt
  CompanyId          Int       @db.UnsignedInt
  Name               String    @db.VarChar(150)
  Email              String    @unique(map: "UK_User_Email") @db.VarChar(255)
  Password           String    @db.VarChar(255)
  HashedRefreshToken String?   @db.VarChar(255)
  PasswordResetToken String?   @db.VarChar(255)
  IsFirstAccess      Boolean   @default(true)
  CreatedAt          DateTime  @default(now())
  UpdatedAt          DateTime  @default(now())
  DeletedAt          DateTime?
  IsSystemRoot       Boolean   @default(false)
  Company            Company   @relation(fields: [CompanyId], references: [Id], map: "FK_User_CompanyId")

  @@index([CompanyId], map: "FK_User_CompanyId")
}

enum Batch_Status {
  SCHEDULED
  RUNNING
  CANCELLED
  FINISHED
  FAILED
}

enum BatchSend_Status {
  WAITING
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
}
