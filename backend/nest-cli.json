{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "mail/layouts/**/*.hbs",
        "outDir": "dist/src"
      },
      {
        "include": "mail/assets/**/*",
        "outDir": "dist/src"
      }
    ]
  }
}
