<!DOCTYPE html>

<html lang="pt-BR">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title> {{ title }} </title>
    </head>

    <body style="margin: 0; padding: 0; background-color: #F0F0F5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; color: #1F2937;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #F3F4F6; width: 100%; padding: 40px 16px;">
            <tr>
                <td align="center">
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width: 520px; background-color: #FFFFFF; border-radius: 12px; border: 1px solid #E5E7EB; padding: 40px 32px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
                        <tr>
                            <td>
                                <p style="margin: 0 0 24px 0; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #223463;">
                                    Sendly
                                </p>

                                <h1 style="margin: 0 0 16px 0; font-size: 22px; font-weight: 700; color: #111827; line-height: 1.3;">
                                    Olá, {{ name }}
                                </h1>

                                <p style="margin: 0 0 12px 0; font-size: 16px; line-height: 1.6; color: #4B5563;">
                                    Você foi registrado com sucesso na nossa plataforma.
                                </p>
                                <p style="margin: 0 0 28px 0; font-size: 16px; line-height: 1.6; color: #4B5563;">
                                    Para começar a utilizar o sistema e configurar seu ambiente, defina sua senha de acesso
                                    clicando no botão abaixo:
                                </p>

                                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 0 32px 0; width: 100%;">
                                    <tr>
                                        <td align="center">
                                            <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                                                <tr>
                                                    <td align="center" style="border-radius: 10px; background-color: #223463;">
                                                        <a href="{{ url }}" target="_blank" rel="noopener noreferrer" style="font-size: 16px; font-weight: 600; color: #FFFFFF; text-decoration: none; display: inline-block; padding: 14px 28px; border-radius: 8px; background-color: #223463; border: 1px solid #223463;">
                                                            Definir senha
                                                        </a>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>

                                <hr style="border: none; border-top: 1px solid #F3F4F6; margin: 0 0 24px 0;">

                                <p style="margin: 0 0 8px 0; font-size: 13px; line-height: 1.5; color: #6B7280;">
                                    Se o botão não funcionar, copie e cole o link abaixo no seu navegador:
                                </p>
                                <p style="margin: 0; font-size: 12px; line-height: 1.4; color: #223463; word-break: break-all;">
                                    <a href="{{ url }}" style="color: #223463; text-decoration: underline;">{{ url }}</a>
                                </p>
                            </td>
                        </tr>
                    </table>
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width: 520px; margin-top: 24px;">
                        <tr>
                            <td align="center">
                                <p style="margin: 0 0 4px 0; font-size: 12px; color: #9CA3AF;">
                                    © 2026 Thesle LTDA | Sendly. Todos os direitos reservados.
                                </p>
                                <p style="margin: 0; font-size: 12px; color: #9CA3AF;">
                                    Se você não solicitou esta ação, ignore este e-mail e informe departamento de tecnologia
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>